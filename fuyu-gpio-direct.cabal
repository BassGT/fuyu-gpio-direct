cabal-version:      3.0
name:               fuyu-gpio-direct 
version:            0.1.0.0
synopsis:           Bindings para libgpiod en Haskell.
license:            LGPL-2.1-or-later
author:             Bass
maintainer:         springtrap9397@gmail.com
category:           System
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Fuyu.GPIO.Direct,
                      Fuyu.GPIO.Direct.Types,
                      Fuyu.GPIO.Direct.Bindings
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      bytestring,
                      unix,
                      vector
    extra-libraries:  gpiod
    hs-source-dirs:   src
    default-language: Haskell2010

