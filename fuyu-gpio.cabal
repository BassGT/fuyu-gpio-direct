cabal-version:      3.0
name:               fuyu-gpio
version:            0.1.0.0
synopsis:           Bindings para libgpiod en Haskell.
license:            GPL-2.0-only
author:             Bass
maintainer:         springtrap9397@gmail.com
category:           System
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Fuyu.GPIO.Direct,
                      Fuyu.GPIO.Direct.Types,
                      Fuyu.GPIO.Direct.Bindings
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      unix
    extra-libraries:  gpiod
    hs-source-dirs:   src
    default-language: Haskell2010

executable led-test1 
    import:           warnings
    main-is:          LedTest1.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -rtsopts 
    
executable button-test1 
    import:           warnings
    main-is:          ButtonTest1.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -rtsopts 
    
executable chip-test1 
    import:           warnings
    main-is:          ChipTest1.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -rtsopts 
    
executable reto-1
    import:           warnings
    main-is:          Reto1.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts 
    
executable reto-2
    import:           warnings
    main-is:          Reto2.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts 
    
executable reto-3
    import:           warnings
    main-is:          Reto3.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio, 
                      time 
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts 
    
executable reto-4
    import:           warnings
    main-is:          Reto4.hs
    build-depends:    base >= 4.19.2.0 && < 4.21,
                      fuyu-gpio, 
                      time 
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts 
    
